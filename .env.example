# Telegram token from @BotFather
TELEGRAM_BOT_TOKEN=

# Supabase project URL, e.g. https://xxxx.supabase.co
SUPABASE_URL=

# IMPORTANT: server-only Service Role key from Supabase.
# Never put this key into NEXT_PUBLIC_* variables or frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# One-time secret used by /connect <secret> inside the Telegram group.
BOT_SETUP_SECRET=change-me-to-a-long-random-secret

# Optional: comma-separated Telegram user IDs allowed to run /connect, /test and /status.
# Leave empty if BOT_SETUP_SECRET is enough for you.
TELEGRAM_ADMIN_IDS=

# How often the bot checks Supabase for changed leads.
POLL_INTERVAL_SECONDS=4

# Refresh operators/groups/plans/settings every N seconds.
REFERENCE_REFRESH_SECONDS=30

# Log level: INFO / DEBUG / WARNING
LOG_LEVEL=INFO
